        "mistralCloudApi": {
          "id": "iExkqlP8urMapI6v",
          "name": "Mistral Cloud account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"vendor_name\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Name of the vendor or business on the invoice/receipt\"\n    },\n    \"invoice_date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Date of the invoice in YYYY-MM-DD format\"\n    },\n    \"total_amount\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Total amount charged on the invoice\"\n    },\n    \"currency\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Currency code, e.g. INR, USD\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\"office supplies\", \"utilities\", \"travel\", \"food\", \"software\", \"other\"],\n      \"description\": \"Best-guess category based on vendor and items\"\n    },\n    \"line_items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": {\n            \"type\": [\"string\", \"null\"]\n          },\n          \"amount\": {\n            \"type\": [\"number\", \"null\"]\n          }\n        },\n        \"required\": [\"description\", \"amount\"]\n      }\n    }\n  },\n  \"required\": [\"vendor_name\", \"invoice_date\", \"total_amount\", \"currency\", \"category\", \"line_items\"]\n}",
        "autoFix": true
      },
